# -*- coding: utf-8 -*-
"""FreeCAD Lay Flat for CNC 0.12.9 -- FreeCAD macro, millimetres. Requires lay_flat_sheet.py.

Run in FreeCAD. Select finished Bodies/parts (optional); otherwise the dialog
lists Bodies. Each solid is one part. Source objects are never changed.
Manual solid-part selection. Panel tags are defaults, never exclusion rules.
Thickness is measured from selected geometry; there is no stock-thickness whitelist.
Supported: planar pockets, perpendicular holes/drill tips, ruled tapered cuts,
and convex edge roundovers. Tapers carry explicit angle/depth contours; rounded
finishing is marked as reference regions. Export solids accompany every export.
Optional native fillet removal affects export copies only, with a selectable radius.
Prismatic/taper geometry is reconstructed; residual removal must stay inside
identified roundover envelopes. Rebate extensions cannot remove final material.
Fixed rotations/grain controls and stock sheets are set in the export dialog.
"""
import csv
import json
import math
import os
import re
import tempfile
import traceback
from datetime import datetime
from pathlib import Path

import FreeCAD as App
import Part

VERSION = '0.12.9'
PANEL_TAG = 'LayFlatPanel'
STOCK_THICKNESS_TOL = 0.05
TOL = 1e-5
ANG_TOL = 1e-7
Z = App.Vector(0, 0, 1)


class ExportError(Exception):
    """Geometry or output that cannot be exported without guessing."""


def sheet_runtime():
    """Load the installed companion that restores saved right-click menus."""
    import sys
    folder = Path(globals().get('__file__', App.getUserMacroDir(True))).resolve()
    if folder.is_file():folder = folder.parent
    if str(folder) not in sys.path:sys.path.insert(0, str(folder))
    try:
        import lay_flat_sheet
    except ImportError as exc:
        raise ExportError('The sheet export companion is missing. Install the complete Lay Flat package, including lay_flat_sheet.py.') from exc
    return lay_flat_sheet


def mm(value):
    return ('%.6f' % float(value)).rstrip('0').rstrip('.') or '0'


def token(value):
    return mm(round(value, 4) + 0.0).replace('.', 'P').replace('-', 'M')


def safe_name(value):
    return re.sub(r'[^A-Za-z0-9_-]+', '_', value).strip('_')[:90] or 'Part'


def flat_face(face):
    result = face.copy()
    result.translate(App.Vector(0, 0, -result.CenterOfMass.z))
    if result.normalAt(0, 0).z < 0:
        result.reverse()
    return result


def face_of_wire(wire):
    result = Part.Face(wire)
    if result.normalAt(0, 0).z < 0:
        result.reverse()
    return result


def is_horizontal(face):
    return isinstance(face.Surface, Part.Plane) and abs(face.normalAt(0, 0).z) > 1 - ANG_TOL


def circle_of_wire(wire):
    edges = [e for e in wire.Edges if e.Length > TOL]
    if not edges or not wire.isClosed() or not all(isinstance(e.Curve, Part.Circle) for e in edges):
        return None
    circle = edges[0].Curve
    if any((e.Curve.Center - circle.Center).Length > TOL or abs(e.Curve.Radius - circle.Radius) > TOL for e in edges):
        return None
    if abs(sum(e.Length for e in edges) - 2 * math.pi * circle.Radius) > TOL:
        return None
    return circle.Center, circle.Radius


def validate_edges(wire):
    if not wire.isClosed():
        raise ExportError('An operation boundary is open.')
    if wire.BoundBox.ZLength > TOL:
        raise ExportError('An operation boundary is not planar after flattening.')
    for edge in wire.Edges:
        if edge.Length <= TOL:
            continue
        if not isinstance(edge.Curve, (Part.Line, Part.Circle)):
            raise ExportError('Unsupported %s boundary; only exact lines and circular arcs are exported.' % type(edge.Curve).__name__)


def flatten_solid(solid, normal=None):
    """Rigidly rotate each solid; never flatten the thickness or scale geometry."""
    if not solid.isValid() or solid.Volume <= 0:
        raise ExportError('Part is not a valid positive-volume solid.')
    candidates = []
    if normal is not None:
        candidates = [App.Vector(normal)]
    else:
        for face in sorted(solid.Faces, key=lambda f: -f.Area):
            if isinstance(face.Surface, Part.Plane):
                n = face.normalAt(0, 0)
                if not any(abs(n.dot(c)) > 1 - ANG_TOL for c in candidates):
                    candidates.append(n)
    if not candidates:
        raise ExportError('No planar board face was found.')
    variants = []
    for n in candidates:
        copy = solid.copy()
        copy.Placement = App.Placement(App.Vector(), App.Rotation(n, Z)).multiply(copy.Placement)
        variants.append((copy.BoundBox.ZLength, copy))
    thickness, copy = min(variants, key=lambda item: item[0])
    if thickness <= TOL:
        raise ExportError('Part has zero thickness.')
    # Resolve the automatic face sign towards the side with more recessed area.
    if normal is None:
        bb = copy.BoundBox
        scores = {1: 0.0, -1: 0.0}
        for face in copy.Faces:
            if is_horizontal(face) and bb.ZMin + TOL < face.CenterOfMass.z < bb.ZMax - TOL:
                scores[1 if face.normalAt(0, 0).z > 0 else -1] += face.Area
        if scores[-1] > scores[1] + TOL:
            copy.rotate(App.Vector(), App.Vector(0, 1, 0), 180)
    # Align the longest horizontal straight edge with X, for readable drawings.
    lines = [e for e in copy.Edges if e.Length > TOL and isinstance(e.Curve, Part.Line)
             and e.BoundBox.ZLength < TOL]
    if lines:
        e = max(lines, key=lambda e: e.Length)
        direction = e.valueAt(e.LastParameter) - e.valueAt(e.FirstParameter)
        angle = math.degrees(math.atan2(direction.y, direction.x)) % 180
        copy.rotate(App.Vector(), Z, -angle)
    bb = copy.optimalBoundingBox()
    copy.translate(App.Vector(-bb.XMin, -bb.YMin, -bb.ZMin))
    if normal is None and copy.BoundBox.ZLength >= min(copy.BoundBox.XLength, copy.BoundBox.YLength) - TOL:
        raise ExportError('Ambiguous board thickness. Select a broad planar face and run again.')
    return copy


def operation(kind, side, face, depth=None, diameter=None, tip_depth=None):
    flat = flat_face(face)
    if any(e.Length > TOL and not isinstance(e.Curve, (Part.Line, Part.Circle)) for e in flat.Edges):
        wires = [Part.Wire(Part.__sortEdges__([canonical_edge(e) for e in w.Edges if e.Length > TOL])) for w in flat.Wires]
        flat = Part.makeFace(wires, 'Part::FaceMakerBullseye').Faces[0]
        if flat.normalAt(0, 0).z < 0:
            flat.reverse()
    for wire in flat.Wires:
        validate_edges(wire)
    if kind == 'OUTLINE':
        layer = 'OUTLINE_THROUGH'
    elif kind == 'CUTOUT':
        layer = 'CUTOUT_THROUGH'
    elif kind == 'HOLE':
        layer = 'HOLE_D%s_%s' % (token(diameter), 'THROUGH' if depth is None else 'DEPTH_%sMM' % token(depth))
        if tip_depth is not None:
            layer += '_TIP_%sMM' % token(tip_depth)
    else:
        layer = 'POCKET_%sMM' % token(depth)
    return {'kind': kind, 'side': side, 'layer': layer, 'depth_mm': depth,
            'diameter_mm': diameter, 'tip_depth_mm': tip_depth, 'face': flat}


def tapered_cone(face):
    if not isinstance(face.Surface, Part.Cone) or abs(face.Surface.Axis.z) < 1 - ANG_TOL:
        return False
    circles = [e.Curve for e in face.Edges if isinstance(e.Curve, Part.Circle) and e.Length > TOL]
    return len({(round(c.Radius, 6), round(c.Center.z, 6)) for c in circles}) >= 2


def orient_pull_front(shape):
    # A tapered pull gets FRONT on the small-opening side. This changes only
    # the rigid orientation; it does not infer a tool direction from a label.
    votes = []
    for face in shape.Faces:
        if tapered_cone(face):
            circles = [e.Curve for e in face.Edges if isinstance(e.Curve, Part.Circle)]
            small, large = min(circles, key=lambda c: c.Radius), max(circles, key=lambda c: c.Radius)
            if abs(small.Center.z-large.Center.z) > TOL:
                votes.append(small.Center.z > large.Center.z)
    if votes and any(v != votes[0] for v in votes):
        raise ExportError('Opposing tapered features need an explicit machining setup.')
    if votes and not votes[0]:
        shape = shape.copy(); shape.rotate(App.Vector(), App.Vector(1, 0, 0), 180)
        b = shape.optimalBoundingBox(); shape.translate(App.Vector(-b.XMin, -b.YMin, -b.ZMin))
    return shape


def exterior_round(face, thickness):
    surface = face.Surface
    radius = getattr(surface, 'Radius', 0)
    if not TOL < radius < thickness / 3:
        return False
    box = face.BoundBox
    if not (box.ZMax <= radius + TOL or box.ZMin >= thickness-radius-TOL):
        return False
    u0,u1,v0,v1 = face.ParameterRange
    u,v = (u0+u1)/2,(v0+v1)/2
    point = face.valueAt(u,v)
    if isinstance(surface, Part.Cylinder):
        if abs(surface.Axis.z) > ANG_TOL:
            return False
        radial = point-surface.Center
        radial -= surface.Axis * radial.dot(surface.Axis)
    elif isinstance(surface, Part.Sphere):
        radial = point-surface.Center
    else:
        return False
    return face.normalAt(u,v).dot(radial) > 0  # Convex edge, not a side bore.



def taper_angle_samples(face, n=5):
    u0,u1,v0,v1 = face.ParameterRange
    out = []
    for i in range(n):
        for j in range(n):
            nz = abs(face.normalAt(u0+(u1-u0)*(i+0.5)/n, v0+(v1-v0)*(j+0.5)/n).z)
            out.append(math.degrees(math.asin(min(1.0, nz))))
    return out


def bspline_taper(face):
    angles = taper_angle_samples(face)
    if max(angles) - min(angles) > 1e-4:
        return None
    angle = sum(angles) / len(angles)
    return angle if 1 < angle < 89 else None


def canonical_edge(edge):
    curve = edge.Curve
    if isinstance(curve, (Part.Line, Part.Circle)):
        return edge
    p0, p1 = edge.FirstParameter, edge.LastParameter
    pts = [edge.valueAt(p0 + (p1 - p0) * k / 16) for k in range(17)]
    a, b = pts[0], pts[-1]
    if (b - a).Length > TOL and abs((b - a).Length - edge.Length) < 1e-6:
        return Part.makeLine(a, b)
    try:
        arc = Part.Arc(a, pts[8], b).toShape()
    except Exception:
        return edge
    c = arc.Curve
    if max(abs((p - c.Center).Length - c.Radius) for p in pts) < 1e-6 and abs(arc.Length - edge.Length) < 1e-6:
        return arc
    return edge


def level_wires(faces, level, bounds):
    edges = []
    for face in faces:
        for edge in face.Edges:
            if edge.Length > TOL and abs(edge.BoundBox.ZMin-level)<TOL and abs(edge.BoundBox.ZMax-level)<TOL:
                if not any(edge.isSame(e) for e in edges): edges.append(edge)
    edges = [canonical_edge(e) for e in edges]
    wires = []
    for chain in Part.sortEdges(edges):
        if not chain: raise ExportError('Cannot order the tapered-cut boundary.')
        wire = Part.Wire(chain)
        if not wire.isClosed():
            ends=[]
            for edge in chain:
                for vertex in edge.Vertexes:
                    point=vertex.Point
                    if not any((point-p).Length<TOL for p in ends): ends.append(point)
            ends=[p for p in ends if sum(any((v.Point-p).Length<TOL for v in e.Vertexes) for e in chain)==1]
            if len(ends)!=2:raise ExportError('An open taper does not have two boundary endpoints.')
            a,b=ends
            on_stock_edge=any(abs(getattr(a,axis)-bound)<TOL and abs(getattr(b,axis)-bound)<TOL
                              for axis, bound in [('x',bounds.XMin),('x',bounds.XMax),('y',bounds.YMin),('y',bounds.YMax)])
            if not on_stock_edge:raise ExportError('Open taper ends do not lie on one panel edge.')
            wire=Part.Wire(chain+[Part.makeLine(a,b)])
        if not wire.isClosed():raise ExportError('Taper boundary is not closed.')
        wires.append(wire)
    return wires


def extract_tapers(shape, faces):
    groups={}
    for face in faces:
        angle=math.degrees(abs(face.Surface.SemiAngle)) if isinstance(face.Surface,Part.Cone) else (bspline_taper(face) if isinstance(face.Surface,Part.BSplineSurface) else math.degrees(math.asin(abs(face.normalAt(0,0).z))))
        fb=face.optimalBoundingBox()
        key=(round(fb.ZMin,4)+0.0,round(fb.ZMax,4)+0.0,round(angle,4))
        groups.setdefault(key,[]).append(face)
    results=[]
    for (low,high,angle),fs in groups.items():
        lower=level_wires(fs,low,shape.optimalBoundingBox());upper=level_wires(fs,high,shape.optimalBoundingBox())
        if not lower or len(lower)!=len(upper):raise ExportError('Taper boundary counts do not match.')
        used=set()
        for lo in lower:
            options=[(i,hi) for i,hi in enumerate(upper) if i not in used]
            i,hi=min(options,key=lambda pair:(Part.Face(lo).CenterOfMass-Part.Face(pair[1]).CenterOfMass).Length)
            used.add(i)
            # Ruled solid is bounded by the exact edge contours of the source faces.
            cut=Part.makeLoft([lo,hi],True,True)
            if not cut.isValid() or len(cut.Solids)!=1:raise ExportError('Taper contours do not form one valid solid.')
            lowface,highface=Part.Face(lo),Part.Face(hi)
            wide,narrow=(lowface,highface) if lowface.Area>highface.Area else (highface,lowface)
            rear=wide.CenterOfMass.z<narrow.CenterOfMass.z
            side='BACK' if rear else 'FRONT'
            thickness=shape.optimalBoundingBox().ZLength
            start=wide.CenterOfMass.z if rear else thickness-wide.CenterOfMass.z
            end=narrow.CenterOfMass.z if rear else thickness-narrow.CenterOfMass.z
            if end<=start+TOL:raise ExportError('Taper cutting depths are reversed.')
            results.append({'solid':cut,'wide':wide,'narrow':narrow,'angle':angle,'side':side,'start':start,'end':end})
    return results


def manufacturing_footprint(shape, horizontal, round_faces):
    projected=[flat_face(f) for f in horizontal]
    # Include exact cross sections at the finishing-radius transitions. Broad
    # faces alone are inset by a roundover and would make the blank too small.
    levels={round(shape.BoundBox.ZLength/2,6)}
    for face in round_faces:
        levels.update([round(face.BoundBox.ZMin,6),round(face.BoundBox.ZMax,6)])
    for level in sorted(levels):
        if TOL<level<shape.BoundBox.ZLength-TOL:
            wires=shape.slice(Z,level)
            if wires:
                section=Part.makeFace(wires,'Part::FaceMakerBullseye')
                for face in section.Faces:projected.append(flat_face(face))
    footprint=projected[0].multiFuse(projected[1:]).removeSplitter() if len(projected)>1 else projected[0]
    if len(footprint.Faces)!=1:raise ExportError('The board silhouette is not one connected planar region.')
    return footprint.Faces[0]

def analyse_solid(solid, label, normal=None):
    shape = orient_pull_front(flatten_solid(solid, normal))
    bb = shape.optimalBoundingBox()
    thickness = bb.ZLength
    volume_tolerance = max(1e-4, shape.Volume * 1e-9)
    horizontal = []
    cones = []
    cylinders = []
    taper_faces, round_faces = [], []
    for i, face in enumerate(shape.Faces):
        surface = face.Surface
        if isinstance(surface, Part.Plane):
            nz = abs(face.normalAt(0, 0).z)
            if nz > 1 - ANG_TOL:
                horizontal.append(face)
            elif nz > ANG_TOL:
                taper_faces.append(face)
        elif isinstance(surface, (Part.Cylinder, Part.Cone)):
            if abs(surface.Axis.z) < 1 - ANG_TOL:
                if exterior_round(face, thickness):
                    round_faces.append(face); continue
                raise ExportError('Face %d is an unsupported side/angled hole.' % (i + 1))
            if tapered_cone(face):
                taper_faces.append(face)
            else:
                (cones if isinstance(surface, Part.Cone) else cylinders).append(face)
        elif isinstance(surface, Part.Sphere) and exterior_round(face, thickness):
            round_faces.append(face)
        elif isinstance(surface, Part.BSplineSurface) and bspline_taper(face) is not None:
            taper_faces.append(face)
        else:
            raise ExportError('Face %d uses unsupported %s geometry.' % (i + 1, type(surface).__name__))
    if not horizontal:
        raise ExportError('No broad planar faces found.')
    silhouette = manufacturing_footprint(shape, horizontal, round_faces)
    outline_face = face_of_wire(silhouette.OuterWire)
    blank = outline_face.extrude(App.Vector(0, 0, thickness))
    operations = [operation('OUTLINE', 'FRONT', outline_face)]
    removals = []
    notes = []
    # Inner loops of the complete silhouette are genuine through-openings.
    for wire in silhouette.Wires:
        if wire.isSame(silhouette.OuterWire):
            continue
        face = face_of_wire(wire)
        circle = circle_of_wire(wire)
        operations.append(operation('HOLE' if circle else 'CUTOUT', 'FRONT', face,
                                    diameter=2 * circle[1] if circle else None))
        removals.append(face.extrude(App.Vector(0, 0, thickness)))
    # Planar recess floors. Keep true islands, but do not turn deeper holes into
    # islands on the pocket layer: the pocket may safely pass over those voids.
    for face in horizontal:
        level = face.CenterOfMass.z
        if level <= TOL or level >= thickness - TOL:
            continue
        is_front = face.normalAt(0, 0).z > 0
        side = 'FRONT' if is_front else 'BACK'
        depth = thickness - level if is_front else level
        direction = App.Vector(0, 0, depth if is_front else -depth)
        region = face_of_wire(face.OuterWire)
        for wire in face.Wires:
            if wire.isSame(face.OuterWire):
                continue
            island = face_of_wire(wire)
            if island.extrude(direction).common(shape).Volume > volume_tolerance:
                region = region.cut(island)
        if len(region.Faces) != 1:
            raise ExportError('A pocket floor could not be resolved into one region.')
        removal = region.extrude(direction)
        if removal.common(shape).Volume > volume_tolerance:
            raise ExportError('An internal floor is covered by solid material (undercut or enclosed cavity).')
        circle = circle_of_wire(region.Faces[0].OuterWire) if len(region.Wires) == 1 else None
        operations.append(operation('HOLE' if circle else 'POCKET', side, region.Faces[0],
                                    depth=depth, diameter=2 * circle[1] if circle else None))
        removals.append(removal)
    # Support true drill-point cones, not countersinks/tapers. Record both the
    # full-diameter depth and the deepest point, from the original board face.
    for cone in cones:
        umin, umax, _, _ = cone.ParameterRange
        if abs(umax - umin - 2 * math.pi) > ANG_TOL:
            raise ExportError('Partial conical surface is unsupported.')
        circles = [e.Curve for e in cone.Edges if e.Length > TOL and isinstance(e.Curve, Part.Circle) and e.Curve.Radius > TOL and e.isClosed()]
        if len(circles) != 1:
            raise ExportError('Countersinks or truncated cones are unsupported; only complete drill tips are supported.')
        base = circles[0].Center
        radius = circles[0].Radius
        zlo, zhi = cone.BoundBox.ZMin, cone.BoundBox.ZMax
        is_front = abs(base.z - zhi) < TOL
        apex = zlo if is_front else zhi
        if abs(apex - base.z) < TOL:
            raise ExportError('Degenerate drill tip.')
        matching = []
        for cylinder in cylinders:
            c = cylinder.Surface
            cu, cv, _, _ = cylinder.ParameterRange
            if abs(cv - cu - 2 * math.pi) > ANG_TOL or abs(c.Radius - radius) > TOL:
                continue
            axis_origin = c.Center
            if math.hypot(axis_origin.x - base.x, axis_origin.y - base.y) > TOL:
                continue
            end = cylinder.BoundBox.ZMin if is_front else cylinder.BoundBox.ZMax
            if abs(end - base.z) < TOL:
                matching.append(cylinder)
        if len(matching) != 1:
            raise ExportError('Drill tip does not have one matching cylindrical bore.')
        side = 'FRONT' if is_front else 'BACK'
        depth = thickness - base.z if is_front else base.z
        tip_depth = thickness - apex if is_front else apex
        if depth <= TOL or tip_depth >= thickness - TOL:
            raise ExportError('Drill tip crosses the opposite face or has ambiguous depth.')
        direction = App.Vector(0, 0, -1 if is_front else 1)
        tip_solid = Part.makeCone(radius, 0, abs(base.z - apex), base, direction)
        shaft = Part.makeCylinder(radius, depth, base, -direction)
        removal = shaft.fuse(tip_solid)
        if removal.common(shape).Volume > volume_tolerance:
            raise ExportError('A drill-tip hole cannot be reached from the broad face.')
        wire = Part.Wire([Part.makeCircle(radius, App.Vector(base.x, base.y, 0))])
        operations.append(operation('HOLE', side, Part.Face(wire), depth, 2 * radius, tip_depth))
        removals.append(removal)
        notes.append('Hole D%s: full diameter to %s mm; drill tip to %s mm, both measured from the original %s surface.' %
                     (mm(2 * radius), mm(depth), mm(tip_depth), side.lower()))
    for taper in extract_tapers(shape, taper_faces):
        removals.append(taper['solid'])
        # The wide mouth must also be clear up to the entry face. For open
        # notches this void joins the stock edge and is not an inner floor wire.
        if taper['start'] > TOL:
            direction=App.Vector(0,0,-taper['start'] if taper['side']=='BACK' else taper['start'])
            entry=taper['wide'].extrude(direction)
            if entry.common(shape).Volume > volume_tolerance:
                raise ExportError('The tapered cut cannot be entered from its wide side.')
            removals.append(entry)
        for contour, reference in [('wide', False), ('narrow', True)]:
            op=operation('TAPER',taper['side'],taper[contour],depth=taper['end'])
            op.update({'angle_deg':taper['angle'],'start_depth_mm':taper['start'],
                       'end_depth_mm':taper['end'],'entry_clearance_depth_mm':taper['start'],'contour':contour,'reference_only':reference})
            op['layer']=('REFERENCE_' if reference else '')+'TAPER_%sDEG_%s_START_%sMM_END_%sMM' % (token(taper['angle']),contour.upper(),token(taper['start']),token(taper['end']))
            operations.append(op)
        notes.append('%s: %s degree tapered cut, wide contour at depth %s mm, narrow contour at depth %s mm. Preserve the front land; use the exact STEP solid to set the cutter.' % (taper['side'],mm(taper['angle']),mm(taper['start']),mm(taper['end'])))
    for face in round_faces:
        if not isinstance(face.Surface,Part.Cylinder):continue
        radius=face.Surface.Radius; box=face.BoundBox
        if min(box.XLength,box.YLength)<=TOL:continue
        side='FRONT' if box.ZMin>thickness/2 else 'BACK'
        region=Part.Face(rectangle_wire(box.XLength,box.YLength,box.XMin,box.YMin))
        op=operation('EDGE_ROUND',side,region,depth=radius)
        op.update({'radius_mm':radius,'reference_only':True})
        op['layer']='REFERENCE_EDGE_ROUND_R%sMM'%token(radius);operations.append(op)
    if round_faces:
        notes.append('Rounded edge finishing regions are reference envelopes, not cutting paths. Exact rounded geometry is retained in STEP and the flat 3D parts.')
    # Strong guard against missed, invented or incorrectly oriented features.
    # Rebuild the final part from exactly these interpreted operations.
    reconstructed = blank
    if removals:
        cutters = removals[0].multiFuse(removals[1:]) if len(removals) > 1 else removals[0]
        reconstructed = blank.cut(cutters)
    extra = reconstructed.cut(shape).Volume
    missing = shape.cut(reconstructed).Volume
    roundover_volume=0.0
    if round_faces and extra>volume_tolerance:
        envelopes=[]
        for face in round_faces:
            box=face.BoundBox
            envelopes.append(Part.makeBox(max(box.XLength, TOL)+2*TOL,max(box.YLength,TOL)+2*TOL,max(box.ZLength,TOL)+2*TOL,
                                         App.Vector(box.XMin-TOL,box.YMin-TOL,box.ZMin-TOL)))
        envelope=envelopes[0].multiFuse(envelopes[1:]) if len(envelopes)>1 else envelopes[0]
        residual=reconstructed.cut(shape)
        extra=residual.cut(envelope).Volume
        roundover_volume=residual.Volume-extra
    if max(extra, missing) > volume_tolerance:
        raise ExportError('Operations do not reproduce this solid outside the labelled rounded-edge finishing regions (unexplained %.6f mm3, overcut %.6f mm3).' % (extra, missing))
    return {'label': label, 'shape': shape, 'width_mm': bb.XLength,
            'height_mm': bb.YLength, 'thickness_mm': thickness,
            'operations': operations, 'notes': sorted(set(notes)),
            'verification': {'unexplained_volume_mm3': extra, 'overcut_volume_mm3': missing,
                             'tolerance_mm3': volume_tolerance, 'roundover_finishing_volume_mm3': roundover_volume,
                             'method': 'Prismatic and ruled-taper reconstruction; remaining removal must lie within convex roundover envelopes.'}}


# Minimal ASCII DXF writer. Geometry stays analytic: closed LWPOLYLINE with
# circular-arc bulges, plus CIRCLE for round holes. No tessellation or splines.
class Dxf:
    def __init__(self, palette=None):
        self.entities = []
        self.palette = palette
        self.layers = {'0': 7, 'LABELS': 7}

    def add_wire(self, wire, layer, dx=0, dy=0, mirror_width=None):
        validate_edges(wire)
        self.layers[layer] = 7  # Final colour is assigned consistently when saving.
        circle = circle_of_wire(wire)
        def point(p):
            return (dx + (mirror_width - p.x if mirror_width is not None else p.x), dy + p.y)
        if circle:
            center, radius = circle
            x, y = point(center)
            self.entities.append([(0, 'CIRCLE'), (100, 'AcDbEntity'), (8, layer), (100, 'AcDbCircle'),
                                  (10, x), (20, y), (30, 0), (40, radius)])
            return
        vertices = []
        last = None
        first = None
        for edge in wire.OrderedEdges:
            if edge.Length <= TOL:
                continue
            a, b = edge.valueAt(edge.FirstParameter), edge.valueAt(edge.LastParameter)
            if edge.Orientation == 'Reversed':
                a, b = b, a
            if last is not None and (a - last).Length > TOL:
                raise ExportError('Wire edge ordering is not continuous.')
            if first is None:
                first = a
            last = b
            bulge = 0.0
            if isinstance(edge.Curve, Part.Circle):
                mid = edge.valueAt((edge.FirstParameter + edge.LastParameter) / 2)
                cross = (mid - a).cross(b - mid).z
                if abs(cross) < 1e-12:
                    raise ExportError('Circular arc direction is ambiguous.')
                sweep = edge.Length / edge.Curve.Radius
                bulge = math.copysign(math.tan(sweep / 4), cross)
                if mirror_width is not None:
                    bulge = -bulge
            x, y = point(a)
            vertices.append((x, y, bulge))
        if first is None or (last - first).Length > TOL:
            raise ExportError('Export polyline did not close.')
        tags = [(0, 'LWPOLYLINE'), (100, 'AcDbEntity'), (8, layer), (100, 'AcDbPolyline'),
                (90, len(vertices)), (70, 1), (38, 0)]
        for x, y, bulge in vertices:
            tags += [(10, x), (20, y)]
            if bulge:
                tags += [(42, bulge)]
        self.entities.append(tags)

    def add_text(self, text, x, y, height=5):
        # DXF text is ASCII; labels are metadata and never cutting geometry.
        text = str(text).encode('ascii', 'replace').decode().replace('\n', ' ')
        self.entities.append([(0, 'TEXT'), (100, 'AcDbEntity'), (8, 'LABELS'), (100, 'AcDbText'),
                              (10, x), (20, y), (30, 0), (40, height), (1, text), (7, 'STANDARD')])

    def add_line(self, a, b, layer='REFERENCE_GRAIN'):
        self.layers[layer] = 7  # Final colour is assigned consistently when saving.
        self.entities.append([(0, 'LINE'), (100, 'AcDbEntity'), (8, layer),
                              (100, 'AcDbLine'), (10, a[0]), (20, a[1]), (30, 0),
                              (11, b[0]), (21, b[1]), (31, 0)])

    def save(self, path):
        palette = self.palette if self.palette is not None else make_layer_palette(self.layers)
        for layer in self.layers:
            if layer not in palette:
                raise ExportError('No colour assigned for layer %s.' % layer)
            self.layers[layer] = palette[layer]['aci']
        tags = [(0, 'SECTION'), (2, 'HEADER'), (9, '$ACADVER'), (1, 'AC1018'),
                (9, '$INSUNITS'), (70, 4), (9, '$MEASUREMENT'), (70, 1),
                (9, '$LUNITS'), (70, 2), (9, '$LUPREC'), (70, 6), (0, 'ENDSEC'),
                (0, 'SECTION'), (2, 'TABLES'),
                (0, 'TABLE'), (2, 'LTYPE'), (70, 1),
                (0, 'LTYPE'), (100, 'AcDbSymbolTableRecord'), (100, 'AcDbLinetypeTableRecord'),
                (2, 'CONTINUOUS'), (70, 0), (3, 'Solid line'), (72, 65), (73, 0), (40, 0), (0, 'ENDTAB'),
                (0, 'TABLE'), (2, 'LAYER'), (70, len(self.layers))]
        for name, colour in sorted(self.layers.items()):
            tags += [(0, 'LAYER'), (100, 'AcDbSymbolTableRecord'), (100, 'AcDbLayerTableRecord'),
                     (2, name), (70, 0), (62, colour), (6, 'CONTINUOUS')]
            if 'true_colour' in palette[name]:
                tags.append((420, palette[name]['true_colour']))
        tags += [(0, 'ENDTAB'), (0, 'TABLE'), (2, 'STYLE'), (70, 1),
                 (0, 'STYLE'), (100, 'AcDbSymbolTableRecord'), (100, 'AcDbTextStyleTableRecord'),
                 (2, 'STANDARD'), (70, 0), (40, 0), (41, 1), (50, 0), (71, 0), (42, 2.5), (3, 'txt'), (4, ''),
                 (0, 'ENDTAB'), (0, 'ENDSEC'), (0, 'SECTION'), (2, 'ENTITIES')]
        for entity in self.entities:
            tags.extend(entity)
        tags += [(0, 'ENDSEC'), (0, 'EOF')]
        # Explicit record handles avoid requiring a reader to repair table heads.
        handled = []
        next_handle = 0x100
        table_name_next = False
        table_handle = None
        for code, value in tags:
            handled.append((code, value))
            if table_name_next:
                table_handle = '%X' % next_handle
                next_handle += 1
                handled += [(5, table_handle), (330, '0'), (100, 'AcDbSymbolTable')]
                table_name_next = False
            elif code == 0 and value == 'TABLE':
                table_name_next = True
            elif code == 0 and value == 'ENDTAB':
                table_handle = None
            elif code == 0 and value in ('LTYPE', 'LAYER', 'STYLE', 'LWPOLYLINE', 'CIRCLE', 'TEXT', 'LINE'):
                handled.append((5, '%X' % next_handle))
                next_handle += 1
                if table_handle is not None:
                    handled.append((330, table_handle))
        with open(path, 'w', encoding='ascii', newline='\n') as stream:
            for code, value in handled:
                # 12 decimal places preserve coordinates and arc bulges.
                value = ('%.12f' % value).rstrip('0').rstrip('.') if isinstance(value, float) else str(value)
                stream.write('%d\n%s\n' % (code, value))


